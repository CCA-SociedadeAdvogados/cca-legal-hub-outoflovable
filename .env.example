# Supabase — variáveis necessárias para o frontend
# Copie este ficheiro para .env.local e preencha com os seus valores reais
# NUNCA faça commit do ficheiro .env.local (está no .gitignore)

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"

# E2E Tests (opcionais — usados apenas por testes Playwright autenticados)
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
